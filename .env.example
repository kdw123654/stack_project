OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8000
JOB_WORKERS=2
JOB_CAPACITY=4
JOB_TTL_SECONDS=3600
JOB_MAX_RECORDS=100
MAX_CONTEXT_CHARACTERS=80000
OCR_ENABLED=true
OCR_MAX_PAGES_PER_FILE=10
JOB_STORE_PATH=data/jobs.sqlite3
DOCUMENT_CONVERTER=

# ---------------------------------------------------------------
# 프론트엔드 (Vite) 설정
# ---------------------------------------------------------------
AI_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_AI_API_BASE_URL=/ai-api
VITE_API_MOCK=false
BACKEND_API_PROXY_TARGET=http://127.0.0.1:8001
VITE_BACKEND_API_BASE_URL=/backend-api/api/v1

# ---------------------------------------------------------------
# B 서버 (server/) 설정
# ※ 이 아래 항목은 server/.env 에 넣어요. B는 server 폴더에서 실행해서 그 파일을 읽어요.
#   위의 A·프론트 항목은 루트 .env 에 넣어요.
# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ALLOWED_EMAIL_DOMAIN=suwon.ac.kr
STORAGE_BUCKET=files
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SOFFICE_PATH=soffice
