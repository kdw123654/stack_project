# Copy to .env and set your own key. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8000
# Optional USD / 1M tokens. Leave blank if pricing has not been confirmed.
# LLM_INPUT_PRICE_PER_MILLION=
# LLM_OUTPUT_PRICE_PER_MILLION=
JOB_WORKERS=2
JOB_CAPACITY=4
JOB_TTL_SECONDS=3600
JOB_MAX_RECORDS=100
MAX_CONTEXT_CHARACTERS=80000
# OCR sends image data to OpenAI and may incur additional usage.
OCR_ENABLED=true
OCR_MAX_PAGES_PER_FILE=10
# AI job results, source text, review history and image cache (not the master DB).
# Empty path disables persistence. Use a writable local directory.
JOB_STORE_PATH=data/jobs.sqlite3
# Optional LibreOffice soffice executable. Legacy HWP/PPT/DOC support depends on installed filters.
DOCUMENT_CONVERTER=
